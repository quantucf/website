{
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/officers",
      "destination": "/leadership/",
      "permanent": true
    },
    {
      "source": "/officers/",
      "destination": "/leadership/",
      "permanent": true
    }
  ]
}
