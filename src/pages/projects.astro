---
import { getCollection } from "astro:content";

import CardGrid from "../components/layout/CardGrid.astro";
import PageSection from "../components/layout/PageSection.astro";
import PageHero from "../components/sections/PageHero.astro";
import ProjectCard from "../components/sections/ProjectCard.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import LinkButton from "../components/ui/LinkButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PROJECT_ARCHIVE_PREVIEW_LIMIT,
  projectArchiveStatuses,
  projectPrimaryStatuses,
  projectStatusLabels,
  sortProjectsByTitle,
} from "../lib/archive";

const projects = await getCollection("projects");
---

<BaseLayout
  title="Projects | Quantitative Finance Club @ UCF"
  description="Explore research and software projects in quantitative finance from students at UCF."
>
  <PageHero
    title="Projects"
    description="Student projects that explore research questions and build tools for quantitative finance."
  />

  {
    projects.length === 0 ? (
      <PageSection>
        <EmptyState subject="projects" />
      </PageSection>
    ) : (
      [...projectPrimaryStatuses, ...projectArchiveStatuses].map((status) => {
        const matchingProjects = projects
          .filter((project) => project.data.status === status)
          .sort(sortProjectsByTitle);
        if (matchingProjects.length === 0) return null;

        const visibleProjects = projectArchiveStatuses.includes(
          status as (typeof projectArchiveStatuses)[number],
        )
          ? matchingProjects.slice(0, PROJECT_ARCHIVE_PREVIEW_LIMIT)
          : matchingProjects;

        return (
          <PageSection>
            <SectionHeader title={projectStatusLabels[status]} />
            <CardGrid class="mt-10">
              {visibleProjects.map((project) => (
                <ProjectCard
                  project={project.data}
                  href={`/projects/${project.id}/`}
                  showStatus={false}
                />
              ))}
            </CardGrid>
            {matchingProjects.length > PROJECT_ARCHIVE_PREVIEW_LIMIT && (
              <div class="mt-10">
                <LinkButton href="/projects/archive/" variant="secondary">
                  View completed projects
                </LinkButton>
              </div>
            )}
          </PageSection>
        );
      })
    )
  }
</BaseLayout>
