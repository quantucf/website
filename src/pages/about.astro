---
import CardGrid from "../components/layout/CardGrid.astro";
import PageSection from "../components/layout/PageSection.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Quantitative Finance Club @ UCF"
  description="Learn about Quantitative Finance Club @ UCF and how students explore financial markets through mathematics, statistics, programming, and research."
>
  <PageHero
    title="About the club"
    description="We give UCF students a place to explore financial markets through mathematics, statistics, programming, and research."
  />

  <PageSection containerClass="grid gap-10 md:grid-cols-[12rem_1fr] md:gap-16">
    <h2 class="text-sm font-semibold tracking-wider uppercase">Purpose</h2>
    <div class="max-w-content space-y-6 text-lg leading-8">
      <p>
        To cultivate a community where UCF students can explore quantitative
        finance, exchange ideas, and learn from one another. Through workshops,
        projects, and discussions, members work with financial data, test ideas,
        and build models and tools.
      </p>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader title="How the club works" />
    <CardGrid columns={3} class="mt-10">
      <article class="border-border bg-surface border p-6">
        <h3 class="text-lg font-semibold">Workshops</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Guided sessions on modeling, programming, market data, financial
          instruments, and research methods.
        </p>
      </article>
      <article class="border-border bg-surface border p-6">
        <h3 class="text-lg font-semibold">Research</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Readings, replications, and initiatives that explore markets, models,
          and financial theory.
        </p>
      </article>
      <article class="border-border bg-surface border p-6">
        <h3 class="text-lg font-semibold">Projects</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Student projects that explore research questions and build tools for
          quantitative finance.
        </p>
      </article>
    </CardGrid>
  </PageSection>
</BaseLayout>
