---
import { getCollection, render, type CollectionEntry } from "astro:content";

import Container from "../../components/layout/Container.astro";
import BoxList from "../../components/ui/BoxList.astro";
import LocalizedDate from "../../components/ui/LocalizedDate.astro";
import MarkdownBody from "../../components/ui/MarkdownBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl } from "../../lib/site";
import { blogPostingJsonLd } from "../../lib/structured-data";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(
    (post) => !post.data.draft,
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = absoluteUrl(`/posts/${post.id}/`);
---

<BaseLayout
  title={`${post.data.title} | Quantitative Finance Club @ UCF`}
  description={post.data.description}
  ogType="article"
  articlePublishedTime={post.data.date.toISOString()}
  jsonLd={blogPostingJsonLd({ post, canonicalUrl })}
>
  <article>
    <Container class="py-16 sm:py-24">
      <div class="max-w-content">
        <a class="text-sm font-semibold underline" href="/posts/">All posts</a>
        <header class="mt-10">
          <h1
            class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            {post.data.title}
          </h1>
          <p class="text-muted-foreground mt-5 text-lg leading-8 text-pretty">
            {post.data.description}
          </p>
          <p
            class="text-muted-foreground mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
          >
            {post.data.author && <span>{post.data.author}</span>}
            <span
              class:list={[post.data.author && "border-border border-l pl-3"]}
            >
              <LocalizedDate
                date={post.data.date}
                format="date"
                dateStyle="long"
                timeZone="UTC"
              />
            </span>
          </p>
        </header>

        <MarkdownBody>
          <Content />
        </MarkdownBody>

        <footer>
          <BoxList
            items={post.data.topics}
            label="Post topics"
            kind="tag"
            class="mt-8"
          />
        </footer>
      </div>
    </Container>
  </article>
</BaseLayout>
