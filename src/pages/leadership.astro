---
import ChevronDown from "@lucide/astro/icons/chevron-down";
import { getCollection } from "astro:content";

import PageSection from "../components/layout/PageSection.astro";
import OfficerCard from "../components/sections/OfficerCard.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import { facultyAdvisor } from "../data/site-content";
import BaseLayout from "../layouts/BaseLayout.astro";

const officers = (await getCollection("officers")).sort(
  (left, right) => left.data.order - right.data.order,
);
const currentOfficers: typeof officers = [];
const officersByTerm = new Map<string, typeof officers>();

for (const officer of officers) {
  const [rosterFolder] = officer.id.split("/");

  if (rosterFolder === "current") {
    currentOfficers.push(officer);
    continue;
  }

  if (!/^\d{4}-\d{2}$/.test(rosterFolder)) {
    throw new Error(
      `Officer "${officer.id}" must be in current/ or a YYYY-YY roster folder.`,
    );
  }

  const roster = officersByTerm.get(rosterFolder);
  if (roster) {
    roster.push(officer);
  } else {
    officersByTerm.set(rosterFolder, [officer]);
  }
}

const pastTerms = [...officersByTerm].sort(([left], [right]) =>
  right.localeCompare(left),
);
---

<BaseLayout
  title="Leadership | Quantitative Finance Club @ UCF"
  description="Meet the student officers and faculty advisor of the Quantitative Finance Club @ UCF."
>
  <PageHero
    title="Leadership"
    description="Meet the club’s officers and advisor."
  />

  <PageSection>
    <SectionHeader title="Officers" />
    <div class="mt-8">
      {
        currentOfficers.length > 0 ? (
          <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {currentOfficers.map((officer) => (
              <OfficerCard officer={officer.data} />
            ))}
          </div>
        ) : (
          <EmptyState subject="officers" />
        )
      }
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader title="Advisor" />
    <div class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      <OfficerCard
        officer={facultyAdvisor}
        profileUrl={facultyAdvisor.profileUrl}
      />
    </div>
  </PageSection>

  {
    pastTerms.map(([year, roster]) => (
      <PageSection class="py-8! sm:py-10!">
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {year.replace("-", "–")} Officers
            </h2>
            <ChevronDown
              class="text-muted-foreground size-5 shrink-0 group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
            {roster.map((officer) => (
              <OfficerCard officer={officer.data} />
            ))}
          </div>
        </details>
      </PageSection>
    ))
  }
</BaseLayout>
