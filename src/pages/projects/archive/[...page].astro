---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";

import CardGrid from "../../../components/layout/CardGrid.astro";
import PageSection from "../../../components/layout/PageSection.astro";
import PaginationNav from "../../../components/navigation/PaginationNav.astro";
import ProjectCard from "../../../components/sections/ProjectCard.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  ARCHIVE_PAGE_SIZE,
  PROJECT_ARCHIVE_PREVIEW_LIMIT,
  projectArchiveStatuses,
  sortCompletedProjects,
} from "../../../lib/archive";

export async function getStaticPaths({
  paginate,
}: GetStaticPathsOptions): Promise<
  ReturnType<GetStaticPathsOptions["paginate"]>
> {
  const completedProjects = (await getCollection("projects"))
    .filter((project) =>
      projectArchiveStatuses.includes(
        project.data.status as (typeof projectArchiveStatuses)[number],
      ),
    )
    .sort(sortCompletedProjects);

  if (completedProjects.length <= PROJECT_ARCHIVE_PREVIEW_LIMIT) return [];

  return paginate(completedProjects, { pageSize: ARCHIVE_PAGE_SIZE });
}

interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page } = Astro.props;
const pageTitle =
  page.currentPage === 1
    ? "Completed projects | Quantitative Finance Club @ UCF"
    : `Completed projects - Page ${page.currentPage} | Quantitative Finance Club @ UCF`;
const pageDescription =
  page.currentPage === 1
    ? "Explore completed research and software projects in quantitative finance from students at UCF."
    : `Explore page ${page.currentPage} of completed research and software projects in quantitative finance from students at UCF.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHero
    title="Completed projects"
    description="Completed student projects in quantitative finance, including research studies and software tools."
  />

  <PageSection>
    <CardGrid>
      {
        page.data.map((project) => (
          <ProjectCard
            project={project.data}
            href={`/projects/${project.id}/`}
            showStatus={false}
            headingLevel="h2"
          />
        ))
      }
    </CardGrid>
    <PaginationNav page={page} />
  </PageSection>
</BaseLayout>
