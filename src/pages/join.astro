---
import CardGrid from "../components/layout/CardGrid.astro";
import PageSection from "../components/layout/PageSection.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import {
  duesOptions,
  joinSocialLinks,
  knightConnectLink,
} from "../data/site-content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import LinkButton from "../components/ui/LinkButton.astro";
---

<BaseLayout
  title="Join | Quantitative Finance Club @ UCF"
  description="Join Quantitative Finance Club @ UCF. Membership is open to UCF students of all majors interested in quantitative finance."
>
  <PageHero
    title="Join us"
    description="Open to UCF students of all majors interested in quantitative finance."
  />

  <PageSection>
    <SectionHeader title="How to join" />
    <CardGrid as="ol" columns={3} class="mt-10">
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="01"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">01</span>
        <h3 class="mt-3 text-lg font-semibold">Join on KnightConnect</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Register through KnightConnect to be added to the official club
          roster.
        </p>
        <div class="mt-auto pt-6">
          <LinkButton
            href={knightConnectLink.href}
            class="w-full"
            target="_blank"
            rel="noreferrer"
            data-join-link={knightConnectLink.label}
          >
            Register on KnightConnect
          </LinkButton>
        </div>
      </li>
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="02"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">02</span>
        <h3 class="mt-3 text-lg font-semibold">Pay dues</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Membership dues help fund club operations and give members access to
          additional resources and exclusive opportunities.
        </p>
        <ul class="mt-5">
          {
            duesOptions.map((option, index) => (
              <>
                {index > 0 && (
                  <li
                    class="flex items-center gap-3 py-4"
                    aria-hidden="true"
                    data-dues-divider
                  >
                    <span class="border-border flex-1 border-t" />
                    <span class="text-muted-foreground text-sm">or</span>
                    <span class="border-border flex-1 border-t" />
                  </li>
                )}
                <li data-dues-option={option.id}>
                  {option.href ? (
                    <LinkButton
                      href={option.href}
                      variant={option.featured ? "primary" : "secondary"}
                      class="w-full"
                      target="_blank"
                      rel="noreferrer"
                      data-dues-link={option.id}
                    >
                      Pay {option.label} — {option.priceLabel}
                    </LinkButton>
                  ) : (
                    <button
                      type="button"
                      class:list={[
                        "inline-flex min-h-11 w-full items-center justify-center border px-5 py-2.5 text-center text-sm font-semibold opacity-60",
                        option.featured
                          ? "bg-accent text-accent-foreground border-accent"
                          : "bg-background text-foreground border-foreground",
                      ]}
                      data-dues-link-placeholder={option.id}
                      disabled
                    >
                      {option.label} — {option.priceLabel}
                      <span class="sr-only">
                        Payment link not yet available
                      </span>
                    </button>
                  )}
                </li>
              </>
            ))
          }
        </ul>
      </li>
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="03"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">03</span>
        <h3 class="mt-3 text-lg font-semibold">Stay connected</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Join our community and follow club announcements, events, and
          opportunities.
        </p>
        <ul class="mt-auto flex flex-wrap gap-3 pt-6">
          {
            joinSocialLinks.map((channel) => (
              <li>
                <a
                  class="border-border bg-surface hover:border-accent hover:text-foreground active:border-accent active:text-foreground inline-flex min-h-11 items-center gap-2 border px-4 py-3 text-sm font-semibold transition-colors"
                  href={channel.href}
                  data-join-link={channel.label}
                  target="_blank"
                  rel="noreferrer"
                >
                  <Icon name={channel.icon} />
                  <span>{channel.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </CardGrid>
  </PageSection>
</BaseLayout>
