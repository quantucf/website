---
import CardGrid from "../components/layout/CardGrid.astro";
import PageSection from "../components/layout/PageSection.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import {
  duesOptions,
  joinSocialLinks,
  knightConnectLink,
} from "../data/site-content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import LinkButton from "../components/ui/LinkButton.astro";
---

<BaseLayout
  title="Join | Quantitative Finance Club @ UCF"
  description="Join Quantitative Finance Club @ UCF. Register on KnightConnect, choose a dues option, and stay connected with the club."
>
  <PageHero
    title="Join"
    description="Open to UCF students of all majors who want to explore quantitative finance."
  />

  <PageSection>
    <SectionHeader title="How to join" />
    <CardGrid as="ol" columns={3} class="mt-10">
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="01"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">01</span>
        <h3 class="mt-3 text-lg font-semibold">Join on KnightConnect</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Register through KnightConnect to be added to the official club
          roster.
        </p>
        <div class="mt-auto pt-6">
          <LinkButton
            href={knightConnectLink.href}
            class="w-full"
            target="_blank"
            rel="noreferrer"
            data-join-link={knightConnectLink.label}
          >
            Register on KnightConnect
          </LinkButton>
        </div>
      </li>
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="02"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">02</span>
        <h3 class="mt-3 text-lg font-semibold">Pay dues</h3>
        <ul class="border-border mt-5 divide-y">
          {
            duesOptions.map((option) => (
              <li
                class="py-4 first:pt-0 last:pb-0"
                data-dues-option={option.id}
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="leading-6 font-semibold">{option.label}</span>
                  <span class="shrink-0 text-lg font-semibold">
                    {option.priceLabel}
                  </span>
                </div>
                <div class="mt-3">
                  {option.href ? (
                    <LinkButton
                      href={option.href}
                      variant={option.featured ? "primary" : "secondary"}
                      class="w-full"
                      target="_blank"
                      rel="noreferrer"
                      data-dues-link={option.id}
                    >
                      {option.actionLabel}
                    </LinkButton>
                  ) : (
                    <span
                      class="border-border bg-muted text-muted-foreground inline-flex min-h-11 w-full items-center justify-center border px-5 py-2.5 text-center text-sm font-semibold"
                      aria-disabled="true"
                      data-dues-link-placeholder={option.id}
                    >
                      Payment link coming soon
                    </span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </li>
      <li
        class="border-border bg-surface flex h-full flex-col border p-6"
        data-join-step="03"
      >
        <span class="text-muted-foreground text-sm" aria-hidden="true">03</span>
        <h3 class="mt-3 text-lg font-semibold">Stay connected</h3>
        <p class="text-muted-foreground mt-3 leading-7">
          Join our community and follow club announcements, events, and
          opportunities.
        </p>
        <ul class="mt-auto flex flex-wrap gap-3 pt-6">
          {
            joinSocialLinks.map((channel) => (
              <li>
                <a
                  class="border-border bg-surface hover:border-accent hover:text-foreground active:border-accent active:text-foreground inline-flex min-h-11 items-center gap-2 border px-4 py-3 text-sm font-semibold transition-colors"
                  href={channel.href}
                  data-join-link={channel.label}
                  target="_blank"
                  rel="noreferrer"
                >
                  <Icon name={channel.icon} />
                  <span>{channel.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </CardGrid>
  </PageSection>
</BaseLayout>
