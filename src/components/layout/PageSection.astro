---
import Container from "./Container.astro";

interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
}

const { id, class: className, containerClass } = Astro.props;
---

<section
  id={id}
  class:list={["border-border border-t py-16 sm:py-20", className]}
>
  <Container class={containerClass}>
    <slot />
  </Container>
</section>
