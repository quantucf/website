---
import Icon, { type IconName } from "./Icon.astro";

export interface ResourceLink {
  label: string;
  href: string;
  icon: IconName;
}

interface Props {
  links: ResourceLink[];
  label: string;
  class?: string;
}

const { links, label, class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-2", className]} aria-label={label}>
  {
    links.map((link) => (
      <li>
        <a
          class="border-border text-muted-foreground hover:border-accent hover:text-foreground active:border-accent active:text-foreground inline-flex min-h-9 items-center gap-2 border bg-transparent px-3 py-2 text-sm font-semibold transition-colors"
          href={link.href}
          aria-label={`${link.label}: ${label}`}
          target="_blank"
          rel="noreferrer"
          data-resource-link={link.label}
        >
          <Icon name={link.icon} class="size-3.5" />
          <span>{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>
