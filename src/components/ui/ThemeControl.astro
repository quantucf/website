---
import moonIcon from "../../assets/icons/moon.svg";
import sunIcon from "../../assets/icons/sun.svg";

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<div
  class:list={["flex min-h-10 items-center justify-center gap-2", className]}
  data-theme-shell
>
  <img class="size-4" src={sunIcon.src} alt="" aria-hidden="true" />
  <label class="relative inline-flex cursor-pointer items-center" for={id}>
    <span class="sr-only">Use dark theme</span>
    <input
      class="peer sr-only"
      id={id}
      type="checkbox"
      role="switch"
      aria-label="Use dark theme"
      data-theme-control
    />
    <span
      class="peer-focus-visible:outline-foreground relative h-5 w-9 rounded-full transition-colors peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform"
      aria-hidden="true"
      data-theme-track></span>
  </label>
  <img class="size-4" src={moonIcon.src} alt="" aria-hidden="true" />
</div>

<script>
  const storageKey = "quant-ucf-theme";
  const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

  function applyTheme(isDark: boolean) {
    const theme = isDark ? "dark" : "light";
    document.documentElement.dataset.theme = theme;

    document
      .querySelectorAll<HTMLInputElement>("[data-theme-control]")
      .forEach((control) => {
        control.checked = isDark;
      });
  }

  applyTheme(document.documentElement.dataset.theme === "dark");

  document
    .querySelectorAll<HTMLInputElement>("[data-theme-control]")
    .forEach((control) => {
      control.addEventListener("change", () => {
        const theme = control.checked ? "dark" : "light";
        document.documentElement.dataset.themePreference = theme;
        localStorage.setItem(storageKey, theme);
        applyTheme(control.checked);
      });
    });

  mediaQuery.addEventListener("change", (event) => {
    if (document.documentElement.dataset.themePreference === "system") {
      applyTheme(event.matches);
    }
  });
</script>
