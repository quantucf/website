---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  variant = "primary",
  class: className,
  ...attributes
} = Astro.props;

const variants = {
  primary:
    "bg-accent text-accent-foreground border-accent hover:bg-foreground hover:border-foreground hover:text-background active:bg-foreground active:border-foreground active:text-background",
  secondary:
    "bg-background text-foreground border-foreground hover:bg-accent-muted hover:border-accent hover:text-foreground active:bg-accent-muted active:border-accent active:text-foreground",
};
---

<a
  {...attributes}
  class:list={[
    "inline-flex min-h-11 items-center justify-center border px-5 py-2.5 text-sm font-semibold transition-colors",
    variants[variant],
    className,
  ]}
  href={href}
>
  <slot />
</a>
