---
import type { CollectionEntry } from "astro:content";

import BoxList from "../ui/BoxList.astro";
import LocalizedDate from "../ui/LocalizedDate.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<article
  class="border-border grid gap-4 py-7 md:grid-cols-[10rem_1fr] md:gap-8"
>
  <div class="text-muted-foreground text-sm leading-6">
    <p>
      <LocalizedDate
        date={post.data.date}
        format="date"
        dateStyle="long"
        timeZone="UTC"
      />
    </p>
    {post.data.author && <p class="mt-1">{post.data.author}</p>}
  </div>
  <div class="max-w-2xl">
    <h2 class="text-xl font-semibold tracking-tight">
      <a class="hover:underline active:underline" href={`/posts/${post.id}/`}>
        {post.data.title}
      </a>
    </h2>
    <p class="text-muted-foreground mt-3 leading-7">
      {post.data.description}
    </p>
    {
      post.data.topics.length > 0 && (
        <BoxList
          items={post.data.topics}
          label="Post topics"
          kind="tag"
          class="mt-5"
        />
      )
    }
  </div>
</article>
