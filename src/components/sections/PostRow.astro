---
import type { CollectionEntry } from "astro:content";

import LocalizedDate from "../ui/LocalizedDate.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<article class="border-border py-7">
  <div class="max-w-2xl">
    <h2 class="text-xl font-semibold tracking-tight">
      <a class="hover:underline active:underline" href={`/posts/${post.id}/`}>
        {post.data.title}
      </a>
    </h2>
    <p class="text-muted-foreground mt-2 leading-7">
      {post.data.description}
    </p>
    <p
      class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
    >
      {post.data.author && <span>{post.data.author}</span>}
      <span class:list={[post.data.author && "border-border border-l pl-3"]}>
        <LocalizedDate
          date={post.data.date}
          format="date"
          dateStyle="long"
          timeZone="UTC"
        />
      </span>
    </p>
  </div>
</article>
