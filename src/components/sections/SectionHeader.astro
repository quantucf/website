---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<header class="max-w-content">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {
    description && (
      <p class="text-muted-foreground mt-3 leading-7 text-pretty">
        {description}
      </p>
    )
  }
</header>
